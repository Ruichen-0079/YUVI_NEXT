{
  "name": "yuvi-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "presnapshot": "npm run build",
    "snapshot": "node dist/maintenance.js snapshot",
    "preverify-snapshot": "npm run build",
    "verify-snapshot": "node dist/maintenance.js verify-snapshot",
    "prerestore": "npm run build",
    "restore": "node dist/maintenance.js restore",
    "prestart:local": "npm run build",
    "start:local": "node scripts/start-local.mjs",
    "presented": "node dist/maintenance.js presented"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
