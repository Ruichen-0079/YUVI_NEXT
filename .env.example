# Example only: no credentials or real personal paths.
# Copy to ~/.config/yuvi-next/local.env OUTSIDE the repository, chmod 600.
# Use absolute paths. Node env files do not expand ~ or $HOME.
# npm run start:local loads it explicitly. Exported environment takes precedence.
# YUVI_LOCAL_ENV_FILE=/absolute/path/to/another/local.env
YUVI_MODEL_BASE_URL=https://api.deepseek.com/v1
YUVI_MODEL=deepseek-flash
YUVI_MODEL_API_KEY=replace-locally
YUVI_DATA_DIR=/absolute/path/to/independent-data
YUVI_PERSONA_FILE=/absolute/path/to/persona.txt
YUVI_HOST=127.0.0.1
YUVI_PORT=8787
YUVI_OWNER_NAME=负责人
YUVI_CONTEXT_EVENTS=200
YUVI_CONTEXT_WRITING_CHARS=16000
YUVI_CONSOLIDATION_MAX_TOKENS=4000
YUVI_CONSOLIDATION_IDLE_MS=3600000
YUVI_MODEL_IDLE_TIMEOUT_MS=60000
YUVI_MODEL_MAX_DURATION_MS=600000
# Default snapshot directory is <YUVI_DATA_DIR>/snapshots.
# YUVI_SNAPSHOT_DIR=/absolute/path/to/snapshots
YUVI_SNAPSHOT_INTERVAL_MS=86400000
# Browser acceptance only; ordinary npm test does not load this file.
# YUVI_CHROMIUM=/absolute/path/to/chromium
# Optional local timezone:
# TZ=Asia/Shanghai
